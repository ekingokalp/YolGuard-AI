# YolGuard AI ortam değişkenleri
# Bu dosyayı .env olarak kopyalayabilirsiniz.

# Opsiyonel: Yapay zekâ raporu için Google AI Studio / Gemini API anahtarı
# https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Opsiyonel: Google Sheets entegrasyonu
# Service account json dosyasını proje klasörüne koyarsanız dosya adını buraya yazın.
GOOGLE_SERVICE_ACCOUNT_FILE=
GOOGLE_SHEET_NAME=YolGuardAI_Logs

# Nominatim kullanırken kendinizi tanıtan User-Agent yazmak iyi uygulamadır.
# Nominatim için uygulamayı tanıtan User-Agent. Kendi e-postanızı yazmanız önerilir.
NOMINATIM_USER_AGENT=YolGuardAI-StudentProject/1.0 (your-email@example.com)
